diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..4b4f898
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,5 @@
+# git archive（本番用 ZIP の作成）で、開発用のファイルを自動的に除外する。
+/.agents        export-ignore
+/tests          export-ignore
+/AGENTS.md      export-ignore
+/.gitattributes export-ignore
diff --git a/.htaccess b/.htaccess
new file mode 100644
index 0000000..c54ffce
--- /dev/null
+++ b/.htaccess
@@ -0,0 +1,11 @@
+# リポジトリ用のファイル（.git/・.agents/・tests/・Markdown など）を Web から読めないようにする。
+# Apache 用の多層防御。本来は本番にこれらを置かないこと（README「本番へのデプロイ」）。
+# Nginx などでは同等の設定をサーバー側に追加する。
+<IfModule mod_authz_core.c>
+	<FilesMatch "(^\.|\.(md|lock|dist|sh|yml|yaml|xml)$)">
+		Require all denied
+	</FilesMatch>
+</IfModule>
+<IfModule mod_alias.c>
+	RedirectMatch 404 "/wp-content/themes/[^/]+/(\.git|\.agents|tests)(/|$)"
+</IfModule>
